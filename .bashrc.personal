####### Aliases:
alias o=xdg-open

# List all, in long format, with type indicators, human readable bytes
alias ll='ls -alFh --time-style=long-iso'
alias lls='ll -S' # Sorted by file size
alias llt='ll -t' # Sorted by time
alias lr='ll -R' # Recursive

# Make parent folders
alias mkdir='mkdir -p'

# More readable
alias du='du -kh'
alias df='df -kTh'

# Pretty-print of some PATH variables:
alias path='echo -e ${PATH//:/\\n}'
alias libpath='echo -e ${LD_LIBRARY_PATH//:/\\n}'

# home WSL aliases
if grep -q Microsoft /proc/version; then
  alias c='cd /mnt/c'
  alias e='cd /mnt/e'
  alias f='cd /mnt/f'
  alias user='cd /mnt/c/Users/katrina'
fi

###### Utility functions

# Deletes all unattached tmux sessions
function tmux-clean() {
  tmux list-sessions | grep -E -v '\(attached\)$' | while IFS='\n' read line; do
      tmux kill-session -t "${line%%:*}"
  done
}

# Find a file with a pattern in name, recursive (eg, `ff resume`)
function ff() { find . -type f -iname '*'"$*"'*' -ls ; }

# Find a file with pattern $1 in name and Execute $2 on it (eg, `fe resume ls`)
function fe() { find . -type f -iname '*'"${1:-}"'*' \
    -exec ${2:-file} {} \;  ; }

# Extracts compressed files by extension
function extract()
{
  if [ -f $1 ] ; then
    case $1 in
      *.tar.bz2)   tar xvjf $1     ;;
      *.tar.gz)    tar xvzf $1     ;;
      *.bz2)       bunzip2 $1      ;;
      *.rar)       unrar x $1      ;;
      *.gz)        gunzip $1       ;;
      *.tar)       tar xvf $1      ;;
      *.tbz2)      tar xvjf $1     ;;
      *.tgz)       tar xvzf $1     ;;
      *.zip)       unzip $1        ;;
      *.Z)         uncompress $1   ;;
      *.7z)        7z x $1         ;;
      *)           echo "'$1' cannot be extracted via >extract<" ;;
    esac
  else
    echo "'$1' is not a valid file!"
  fi
}

# Creates an archive (*.tar.gz) from given directory.
function maketar() { tar cvzf "${1%%/}.tar.gz"  "${1%%/}/"; }

# Create a ZIP archive of a file or folder.
function makezip() { zip -r "${1%%/}.zip" "$1" ; }

# Make your directories and files access rights sane.
function sanitize() { chmod -R u=rwX,g=rX,o= "$@" ;}

# Adds something to the PATH iff it's not already there.
# Usage: pathmunge /sbin/ (adds to beginning)
#        pathmunge /usr/sbin/ after (adds to end)
pathmunge() {
  if ! echo "$PATH" | /bin/grep -Eq "(^|:)$1($|:)" ; then
    if [ "$2" = "after" ] ; then
      PATH="$PATH:$1"
    else
      PATH="$1:$PATH"
    fi
  fi
}

# Allow subl to be used with WSL
if [ -f "/mnt/c/Program Files/Sublime Text 3/subl.exe" ]; then
  subl() {
    "/mnt/c/Program Files/Sublime Text 3/subl.exe" $(wslpath -w $1)
  }
fi

# Moves a file, leaving a symlink behind
function ml() {
  while [ $# -gt 1 ]; do
    eval "target=\${$#}"
    original="$1"
    if [ -d "$target" ]; then
      target="$target/${original##*/}"
    fi
    mv -- "$original" "$target"
    case "$original" in
      */*)
        case "$target" in
          /*) :;;
          *) target="$(cd -- "$(dirname -- "$target")" && pwd)/${target##*/}"
        esac
    esac
    ln -s -- "$target" "$original"
    shift
  done
}

##### Generic variables

# Normal Colors (eg, use with ${Red}${On_Yellow}Hello!${NC})
Black='\e[0;30m'        # Black
Red='\e[0;31m'          # Red
Green='\e[0;32m'        # Green
Yellow='\e[0;33m'       # Yellow
Blue='\e[0;34m'         # Blue
Purple='\e[0;35m'       # Purple
Cyan='\e[0;36m'         # Cyan
White='\e[0;37m'        # White

# Bold
BBlack='\e[1;30m'       # Black
BRed='\e[1;31m'         # Red
BGreen='\e[1;32m'       # Green
BYellow='\e[1;33m'      # Yellow
BBlue='\e[1;34m'        # Blue
BPurple='\e[1;35m'      # Purple
BCyan='\e[1;36m'        # Cyan
BWhite='\e[1;37m'       # White

# Background
On_Black='\e[40m'       # Black
On_Red='\e[41m'         # Red
On_Green='\e[42m'       # Green
On_Yellow='\e[43m'      # Yellow
On_Blue='\e[44m'        # Blue
On_Purple='\e[45m'      # Purple
On_Cyan='\e[46m'        # Cyan
On_White='\e[47m'       # White

NC="\e[m"               # Color Reset

# Test connection type:
if [ -n "${SSH_CONNECTION}" ]; then
  CNX=${Green}        # Connected on remote machine, via ssh (good).
elif [[ "${DISPLAY%%:0*}" != "" ]]; then
  CNX=${ALERT}        # Connected on remote machine, not via ssh (bad).
else
  CNX=${BCyan}        # Connected on local machine.
fi


####### Options

# Eg, `kmitchell@Kats-desktop:/mnt/c(123)$ `
PS1="\[${BCyan}\]\u\[${NC}\]@\[${CNX}\]\h\[${NC}\]:\[${Green}\](\t)\[${Purple}\]\$ \[${NC}\]"

# LESS man page colors (makes man pages more readable).
export LESS_TERMCAP_mb=$'\E[01;31m'
export LESS_TERMCAP_md=$'\E[01;31m'
export LESS_TERMCAP_me=$'\E[0m'
export LESS_TERMCAP_se=$'\E[0m'
export LESS_TERMCAP_so=$'\E[01;44;33m'
export LESS_TERMCAP_ue=$'\E[0m'
export LESS_TERMCAP_us=$'\E[01;32m'

# Sane program choices
export EDITOR=vim
export PAGER=less

# Don't put duplicate lines in the history
export HISTCONTROL=ignoredups

# Correct typos with cd
shopt -s cdspell

# Env var tab expansion with cd
shopt -s cdable_vars

# Multi-line history
shopt -s cmdhist

# Don't overwrite history each time
shopt -s histappend

# Case insensitive tab completion and globing
shopt -s nocasematch nocaseglob

####### Auto-complete
if [ -f /etc/bash_completion ]; then
  . /etc/bash_completion
fi

####### SSH setup
if [ -z "$SSH_AUTH_SOCK" ] ; then
  eval "$(ssh-agent -s)"
  ssh-add ~/.ssh/id_rsa
fi

####### PATH changes
pathmunge ~/go/bin after
pathmunge ~/.local/bin after # eg, pip stuff
